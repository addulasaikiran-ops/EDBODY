{
  "name": "edbody-desktop",
  "version": "0.1.0",
  "author": {
    "name": "EDBODY contributors",
    "email": "edbody-maintainers@users.noreply.github.com"
  },
  "private": true,
  "description": "EDBODY desktop human digital twin research prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --publish never --win",
    "dist:mac": "npm run build && electron-builder --publish never --mac",
    "dist:linux": "npm run build && electron-builder --publish never --linux",
    "smoke:linux": "xvfb-run -a env EDBODY_SMOKE_TEST=1 electron --no-sandbox --use-gl=angle --use-angle=swiftshader-webgl --enable-unsafe-swiftshader ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.16.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.edbody.desktop",
    "productName": "EDBODY",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/**/*",
      "LICENSES/**/*",
      "docs/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Science;MedicalSoftware",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
